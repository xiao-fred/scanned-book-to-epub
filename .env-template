# Copy this file to PROJECT/.env and replace the placeholders.
# Existing shell environment variables take precedence over these values.

# OpenAI-compatible chat/completions endpoint used by hosted translation.
BOOK2EPUB_TRANSLATION_URL=https://coding.efficient.center/api/v1/responses

# API key for the translation provider.
BOOK2EPUB_TRANSLATION_KEY=replace-with-your-api-key

# Translation model name.
BOOK2EPUB_TRANSLATION_MODEL=gpt-5.6-terra

# Truthful client identifier. Replace only with a value explicitly provided
# or approved by your service administrator.
OOK2EPUB_USER_AGENT=codex/0.1

# Multimodal model used for page-image + OCR correction.
BOOK2EPUB_CORRECTION_MODEL=gpt-5.6-luna

# Minimum seconds between hosted correction/translation request starts.
# Requests are serialized across both models; default is 1 second.
# BOOK2EPUB_REQUEST_DELAY=1.0

# Retry failed hosted LLM calls with exponential backoff (5s, 10s, 20s, ...).
# BOOK2EPUB_LLM_MAX_ATTEMPTS=10
# BOOK2EPUB_RETRY_DELAY=5.0

# Parallel LLM workers (bounded to 1..3). Correction defaults to 3;
# assembly defaults to 2 because its prompts are larger and windows overlap.
# BOOK2EPUB_CORRECTION_WORKERS=3
# BOOK2EPUB_ASSEMBLY_WORKERS=2
# Random one-time startup delay per worker (seconds), to avoid an initial burst.
# BOOK2EPUB_CORRECTION_START_JITTER=2
# BOOK2EPUB_ASSEMBLY_START_JITTER=2

# Maximum words in an assembled body paragraph before sentence-boundary splitting.
# BOOK2EPUB_ASSEMBLY_MAX_WORDS=200

# Optional accounting defaults. Set provider pricing in a future pricing.json
# when you want monetary cost estimates instead of token-only totals.
# BOOK2EPUB_CURRENCY=USD
